{
  "name": "@kubohiroya/turbowarp-jsqr",
  "version": "0.7.1",
  "author": {
    "name": "Hiroya Kubo",
    "email": "hiroya@cuc.ac.jp",
    "url": "https://github.com/kubohiroya"
  },
  "description": "Read QR codes, including Structured Append sequences, from a shared TurboWarp camera source. Decodes with zxing-cpp.",
  "type": "module",
  "license": "MPL-2.0",
  "homepage": "https://kubohiroya.github.io/turbowarp-jsqr/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubohiroya/turbowarp-jsqr.git"
  },
  "bugs": {
    "url": "https://github.com/kubohiroya/turbowarp-jsqr/issues"
  },
  "exports": {
    "./jsqr.js": "./dist/jsqr.js",
    "./package.json": "./package.json"
  },
  "files": [
    "assets/",
    "dist/",
    "README.md",
    "README.ja.md",
    "LICENSE"
  ],
  "unpkg": "./dist/jsqr.js",
  "jsdelivr": "./dist/jsqr.js",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@11.28.8",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "lint": "eslint src tests vite.config.ts",
    "test": "vitest run",
    "docs": "node scripts/generate-readme.ts",
    "docs:check": "pnpm run docs && git diff --exit-code -- README.md",
    "docs:pages:check": "node scripts/check-pages.ts",
    "repo:check": "node scripts/check-repo.ts",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "release:check": "pnpm publish --dry-run --access public --no-git-checks",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run docs:check && pnpm run docs:pages:check && pnpm run check:dist && pnpm run repo:check && pnpm run pack:check && pnpm run samples:check",
    "check:dist": "pnpm run build && node scripts/check-dist.ts",
    "prepack": "pnpm run check",
    "samples:build": "node scripts/build-samples.mjs",
    "samples:check": "node scripts/build-samples.mjs --check && node --test scripts/verify-samples.mjs",
    "pages:build": "node scripts/prepare-pages.mjs"
  },
  "peerDependencies": {
    "@kubohiroya/turbowarp-camera-source": "^0.22.0"
  },
  "peerDependenciesMeta": {
    "@kubohiroya/turbowarp-camera-source": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@kubohiroya/turbowarp-camera-source": "^0.22.0",
    "@kubohiroya/turbowarp-extension-manifest": "^0.5.0",
    "@kubohiroya/vite-plugin-turbowarp-extension": "^0.10.0",
    "@types/node": "^24.13.3",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "turbowarp",
    "scratch",
    "extension",
    "qr",
    "qrcode",
    "camera"
  ],
  "dependencies": {
    "zxing-wasm": "3.1.4"
  }
}
